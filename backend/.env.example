# এই ফাইল কপি করে ".env" নামে সেভ করো, তারপর আসল ভ্যালু বসাও।
# .env কে .gitignore এ রাখতে হবে।
#
#   cp .env.example .env

# SQLite ডাটাবেস ফাইলের পাথ (ডিফল্ট backend ফোল্ডারের ভিতরেই থাকবে)
DATABASE_URL=sqlite:///./ecg.db

# OpenRouter API key (https://openrouter.ai/keys থেকে নেওয়া)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter এ যে মডেল ব্যবহার করবে চ্যাটবট + এনালাইসিসের জন্য
OPENROUTER_MODEL=anthropic/claude-3.5-haiku

# CORS - কোন origin থেকে frontend রিকোয়েস্ট আসবে (Next.js dev server)
FRONTEND_ORIGIN=http://localhost:3000
